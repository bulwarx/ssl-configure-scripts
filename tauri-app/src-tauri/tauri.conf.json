{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSL Configurator",
  "version": "0.4.0",
  "identifier": "com.bulwarx.ssl-configurator",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bulwarx SSL Configurator",
        "width": 1040,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../assets/bulwarx-identity-small-picture.png": "assets/bulwarx-identity-small-picture.png"
    }
  }
}
